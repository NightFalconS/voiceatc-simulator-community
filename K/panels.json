{
  "$schema": "../tools/interface_contract/interface.schema.json",
  "name": "US (STARS)",
  "author": "Lainoa Software",
  "description": "The US STARS look over Generic: green text on the scope, a DCB of square buttons with menus docked under it.",
  "extends": "generic",
  "tokens": {
    "colors": {
      "bar": "000C00",
      "edge": "323232",
      "panel": "000000",
      "title": "000000",
      "accent": "002F00",
      "well": "000000",
      "button": "001A00",
      "text": "00CC00",
      "dim": "3F7F3F",
      "on": "CCCCCC",
      "value": "CCCCCC",
      "strip": "E6E6D9",
      "bevel_light": "323232",
      "bevel_dark": "000000",
      "selection": "002F00",
      "selection_text": "CCCCCC",
      "field": "000000",
      "field_text": "00CC00",
      "inactive": "001A00",
      "ok": "00CC00",
      "warn": "CCCC00",
      "alert": "CC0000",
      "clock": "00CC00",
      "hover_text": "CCCC00",
      "strip_text": "1A1A1A",
      "scope": "000000"
    },
    "fonts": { "text": "courier_prime", "data": "courier_prime" },
    "type": {
      "title": 15,
      "list": 15,
      "field": 15,
      "small": 10,
      "caption": 15,
      "tick": 15
    },
    "case": "upper",
    "bevel": { "width": 3 }
  },
  "primitives": {
    "window": {
      "close": "hidden",
      "title": { "height": 18, "pad": [0, 0, 0, 0] },
      "body": { "pad": [0, 0, 0, 0], "gap": 0, "box": { "kind": "none" } },
      "states": {
        "normal": {
          "box": { "kind": "none" },
          "text": "text",
          "weight": 700,
          "spacing": 0
        },
        "focused": { "box": { "kind": "none" } }
      }
    },
    "list": {
      "row_height": 18,
      "separation": 0,
      "panel": { "kind": "none" },
      "current": { "mark": "NOW", "left_bar": 0 },
      "states": {
        "normal": { "weight": 700 },
        "hover": { "box": { "kind": "none" }, "text": "hover_text" },
        "current": { "text": "on" }
      }
    },
    "field": {
      "height": 18,
      "states": {
        "normal": {
          "box": {
            "kind": "flat",
            "fill": "field",
            "border": 0,
            "pad": [0, 0, 0, 0]
          },
          "text": "field_text",
          "selection": "selection"
        }
      }
    },
    "button": {
      "height": 36,
      "small_height": 18,
      "pad_x": 8,
      "small_pad_x": 4,
      "states": {
        "normal": {
          "box": {
            "kind": "bevel",
            "fill": "button",
            "border": 3,
            "raised": true,
            "light": "bevel_light",
            "dark": "bevel_dark"
          },
          "text": "value",
          "font": "data",
          "weight": 700
        },
        "hover": { "box": { "blend_amount": 0 }, "text": "hover_text" },
        "on": { "box": { "fill": "accent", "raised": false } }
      }
    },
    "tick": {
      "row_height": 18,
      "off_mark": { "kind": "flat", "border": 1, "border_color": "text" },
      "states": {
        "normal": { "font": "data", "weight": 700 },
        "hover": { "text": "hover_text" }
      }
    },
    "caption": {
      "states": {
        "normal": {
          "text": "text",
          "font": "data",
          "weight": 700,
          "spacing": 0
        }
      }
    },
    "bar": {
      "height": 72,
      "states": {
        "normal": { "box": { "kind": "flat", "fill": "bar", "border": 0 } }
      }
    }
  },
  "components": {
    "top": {
      "mode": "dcb_grid",
      "slots": {
        "columns": [
          { "ids": ["maps"] },
          { "ids": ["procs"] },
          { "ids": ["airspaces"] },
          { "ids": ["tag", "range"] },
          { "ids": ["vector", "tl"] },
          { "ids": ["com", "tfc"] },
          { "ids": ["vprof"] },
          { "ids": ["warp", "pause"] },
          { "ids": ["clr_qdm", "clr_routes"] },
          { "ids": ["settings"], "width": 1.5 }
        ],
        "status": [["clock", "airport", "qnh"], ["rwy"], ["radio"]]
      },
      "templates": {
        "maps": "MAPS",
        "procs": "PROCS",
        "airspaces": "AIR\nSPACE",
        "tag": "TAG\n{value}",
        "range": "RANGE\n{value}",
        "vector": "VECTOR\n{value}",
        "tl": "TL\n{value}",
        "com": "COM",
        "tfc": "TFC",
        "vprof": "VPROF",
        "warp": "WARP\nX{value}",
        "pause": "PAUSE",
        "clr_qdm": "CLR\nQDM",
        "clr_routes": "CLR\nROUTES",
        "settings": "SET\nTINGS"
      }
    },
    "bottom": { "mode": "merged_into_top" },
    "radio": { "mode": "status_line" },
    "value_popup": {
      "mode": "dock_strip",
      "templates": {
        "unrestricted": "UNRES\nTRICT",
        "via": "VIA\n{value}",
        "resume": "RESUME\nMGD",
        "send_typed": "ENTER"
      }
    },
    "wpt": { "mode": "dock_strip" },
    "menus": { "mode": "dock_strip" },
    "tfc": { "mode": "paper_us" },
    "com": {
      "mode": "scope_lines",
      "widths": {
        "who": 70,
        "command": 176,
        "window": 660,
        "log": 660,
        "log_height": 190
      },
      "log": { "kind": "none" },
      "type": "list",
      "weight": 600,
      "case": "upper"
    },
    "vprof": {
      "mode": "scope",
      "well": { "kind": "flat", "fill": "scope" },
      "plot_colors": "skin"
    },
    "tl": { "width": 90, "templates": { "tl_list": "{value}" } }
  }
}
