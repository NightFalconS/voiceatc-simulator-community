{
  "$schema": "../interface.schema.json",
  "name": "Generic",
  "description": "The game's own interface: every key, the base every skin extends.",
  "tokens": {
    "colors": {
      "bar": "1F2535",
      "edge": "394258",
      "panel": "1B2130",
      "title": "333B50",
      "accent": "4B546D",
      "well": "141926",
      "button": "2A3142",
      "text": "CDD3E0",
      "dim": "8891A6",
      "on": "9DB0DA",
      "value": "FFFFFF",
      "strip": "23262E",
      "bevel_light": "394258",
      "bevel_dark": "141926",
      "selection": "4B546D",
      "selection_text": "FFFFFF",
      "field": "141926",
      "field_text": "FFFFFF",
      "inactive": "333B50",
      "ok": "9FE0B8",
      "warn": "F2C14E",
      "alert": "FF7A7A",
      "clock": "FFFFFF",
      "hover_text": "FFFFFF",
      "strip_text": "CDD3E0",
      "scope": "0E131C",
      "radio_rx": "2E4A3A",
      "radio_rx_text": "9FE0B8",
      "radio_tx": "5A2E2E",
      "radio_tx_text": "FFB3B3",
      "radio_blocked": "5A4A1E",
      "radio_blocked_text": "F2C14E",
      "radio_parsing": "2F3A5A",
      "radio_parsing_text": "B9C8F0"
    },
    "fonts": { "text": "noto_sans", "data": "courier_prime" },
    "type": {
      "title": 13,
      "list": 14,
      "field": 14,
      "button": 13,
      "small": 11,
      "caption": 11,
      "tick": 13,
      "close": 16,
      "bar_key": 12,
      "bar_value": 15,
      "bar_label": 13,
      "dcb": 13,
      "status": 15
    },
    "case": "as_written",
    "bevel": { "width": 0 }
  },
  "primitives": {
    "window": {
      "top_strip": "none",
      "close": "glyph",
      "strip": {
        "height": 10,
        "fill": "accent",
        "inactive": "inactive",
        "cell_glyph": "▪▫",
        "cell_width": 19,
        "box": {
          "kind": "bevel",
          "border": 1,
          "raised": true,
          "edge_lighten": 0.5,
          "edge_darken": 0.45
        }
      },
      "close_button": {
        "glyph": "×",
        "width": 20,
        "height": 20,
        "states": {
          "normal": {
            "box": { "kind": "none" },
            "text": "text",
            "font": "text",
            "type": "close"
          },
          "hover": { "text": "value" }
        }
      },
      "title": {
        "height": 26,
        "align": "left",
        "pad": [10, 0, 8, 0],
        "gap": 16
      },
      "body": {
        "pad": [10, 10, 10, 10],
        "gap": 8,
        "box": {
          "kind": "flat",
          "fill": "panel",
          "border": 1,
          "border_color": "edge"
        }
      },
      "states": {
        "normal": {
          "box": { "kind": "flat", "fill": "title" },
          "text": "value",
          "font": "data",
          "type": "title",
          "spacing": 0.06
        },
        "focused": { "box": { "fill": "accent" } }
      }
    },
    "list": {
      "row_height": 24,
      "separation": 8,
      "panel": {
        "kind": "flat",
        "fill": "well",
        "border": 1,
        "border_color": "edge"
      },
      "current": { "mark": "", "left_bar": 3, "left_bar_color": "on" },
      "states": {
        "normal": {
          "box": { "kind": "none" },
          "text": "text",
          "font": "data",
          "type": "list"
        },
        "hover": {
          "box": { "kind": "flat", "fill": "accent" },
          "text": "value"
        },
        "current": { "text": "value" }
      }
    },
    "field": {
      "height": 26,
      "states": {
        "normal": {
          "box": {
            "kind": "flat",
            "fill": "well",
            "border": 1,
            "border_color": "on",
            "pad": [8, 0, 8, 0]
          },
          "text": "value",
          "font": "data",
          "type": "field",
          "selection": "accent",
          "placeholder": "dim"
        }
      }
    },
    "button": {
      "height": 28,
      "small_height": 20,
      "pad_x": 12,
      "small_pad_x": 6,
      "states": {
        "normal": {
          "box": {
            "kind": "flat",
            "fill": "button",
            "border": 1,
            "border_color": "accent"
          },
          "text": "text",
          "font": "text",
          "weight": 600,
          "type": "button"
        },
        "hover": {
          "box": { "blend": "accent", "blend_amount": 0.5 },
          "text": "value"
        },
        "on": { "box": { "fill": "accent" }, "text": "value" },
        "disabled": { "text": "dim" }
      }
    },
    "tick": {
      "size": 12,
      "separation": 8,
      "row_height": 24,
      "on_mark": { "kind": "flat", "fill": "on" },
      "off_mark": { "kind": "flat", "border": 1, "border_color": "dim" },
      "states": {
        "normal": { "text": "text", "font": "text", "type": "tick" },
        "disabled": { "text": "dim" }
      }
    },
    "caption": {
      "states": {
        "normal": {
          "text": "dim",
          "font": "text",
          "weight": 600,
          "type": "caption",
          "spacing": 0.08
        }
      }
    },
    "bar": {
      "height": 40,
      "states": {
        "normal": {
          "box": {
            "kind": "flat",
            "fill": "bar",
            "border": 1,
            "border_color": "edge"
          }
        }
      }
    },
    "bar_cell": {
      "key": {
        "text": "dim",
        "font": "text",
        "weight": 600,
        "type": "bar_key"
      },
      "value": { "text": "value", "font": "data", "type": "bar_value" },
      "divider": 1,
      "divider_color": "edge",
      "side_pad": 14,
      "compact_pad": 10,
      "key_gap": 8,
      "group_gap": 10,
      "value_tint": false,
      "button_pad": [4, 0, 4, 3],
      "step": {
        "box": {
          "kind": "flat",
          "fill": "button",
          "border": 1,
          "border_color": "accent"
        },
        "text": "value",
        "font": "data",
        "weight": 400,
        "type": "bar_label"
      },
      "step_width": 22,
      "step_height": 20,
      "step_gap": 6,
      "states": {
        "normal": {
          "box": { "kind": "none" },
          "text": "text",
          "font": "text",
          "weight": 600,
          "type": "bar_label"
        },
        "hover": { "box": { "kind": "flat", "fill": "button" } },
        "on": {
          "box": {
            "kind": "flat",
            "fill": "accent",
            "underline": 3,
            "underline_color": "on"
          },
          "text": "value"
        },
        "disabled": { "text": "dim" }
      }
    },
    "dcb_button": {
      "unit": 72,
      "line_height": 15,
      "pad": 4,
      "states": {
        "normal": {
          "box": {
            "kind": "bevel",
            "fill": "button",
            "raised": true,
            "light": "bevel_light",
            "dark": "bevel_dark"
          },
          "text": "value",
          "font": "text",
          "weight": 700,
          "type": "dcb"
        },
        "hover": { "text": "hover_text" },
        "on": { "box": { "fill": "accent", "raised": false } },
        "disabled": { "text": "dim" }
      }
    },
    "status_line": {
      "line_height": 18,
      "inset": 10,
      "gap": 9,
      "states": {
        "normal": { "text": "text", "font": "data", "type": "status" },
        "hover": { "text": "hover_text" }
      }
    }
  },
  "components": {
    "top": {
      "mode": "cell_row",
      "slots": {
        "left": ["airport", "qnh", "tl", "rwy", "radio"],
        "right": ["com", "tfc", "vprof", "clock", "warp", "pause", "settings"]
      }
    },
    "bottom": { "mode": "cell_row" },
    "radio": { "mode": "pills" },
    "value_popup": {
      "mode": "list_window",
      "templates": {
        "unrestricted": "Unrestricted",
        "via": "Via {value}",
        "resume": "Resume managed speed"
      }
    },
    "wpt": { "mode": "window" },
    "menus": { "mode": "kit_window" },
    "tfc": { "mode": "dark" },
    "com": {
      "mode": "table",
      "widths": {
        "who": 62,
        "command": 150,
        "window": 640,
        "log": 618,
        "log_height": 144
      },
      "log": { "kind": "none" },
      "type": "list",
      "weight": 400,
      "case": "as_written"
    },
    "vprof": {
      "mode": "well",
      "well": { "kind": "none" },
      "plot_colors": "own"
    },
    "tl": {
      "mode": "list",
      "width": 130,
      "templates": { "tl_list": "FL{value}" }
    }
  }
}
