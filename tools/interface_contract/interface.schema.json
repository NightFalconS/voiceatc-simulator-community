{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VoiceATC session interface (panels.json)",
  "description": "A session interface: tokens (colours, fonts, type sizes), primitives (how each kind of control looks in each state) and components (which layout mode each part of the screen uses and where its features sit). A skin extends Generic or another skin and writes only what it changes. Keys this build does not know are skipped by the game; the validator's strict mode reports them. Page: documentation/systems/interface-language.md",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional: the path of this schema, for editor autocomplete."
    },
    "name": {
      "type": "string",
      "maxLength": 40,
      "description": "The skin's name in Settings > Skin."
    },
    "author": {
      "type": "string",
      "maxLength": 60,
      "description": "Who made the skin."
    },
    "description": {
      "type": "string",
      "maxLength": 200,
      "description": "One line about the skin."
    },
    "extends": {
      "type": "string",
      "default": "generic",
      "description": "The skin this one starts from: `generic`, or an installed skin id (`skin:<id>` from the catalog, `scope:<path>` for a regional skin). Objects merge key by key; arrays and plain values replace. An unknown base starts from Generic."
    },
    "tokens": { "$ref": "#/$defs/tokens" },
    "primitives": { "$ref": "#/$defs/primitives" },
    "components": { "$ref": "#/$defs/components" }
  },
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$",
      "description": "RRGGBB or RRGGBBAA, no #."
    },
    "color_role": {
      "type": "string",
      "x-ref": "colors",
      "description": "A colour role named in tokens.colors."
    },
    "font_role": {
      "type": "string",
      "x-ref": "fonts",
      "description": "A font role named in tokens.fonts (text or data)."
    },
    "type_role": {
      "type": "string",
      "x-ref": "type",
      "description": "A size role named in tokens.type."
    },
    "px": {
      "type": "integer",
      "minimum": 0,
      "maximum": 400,
      "x-px": true,
      "description": "Whole design pixels at interface size 1.0; the game scales and rounds them (UiScale)."
    },
    "panel_px": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1600,
      "x-px": true,
      "description": "A panel width or height in whole design pixels at interface size 1.0; the game scales and rounds it (UiScale)."
    },
    "pad": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0, "maximum": 64, "x-px": true },
      "minItems": 4,
      "maxItems": 4,
      "description": "Left, top, right, bottom padding in px."
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "description": "The named values every primitive refers to.",
      "properties": {
        "colors": {
          "type": "object",
          "description": "Colour roles. Generic's roles are listed; a skin may add its own role names for its primitives to use. The player can recolour every role in Settings > Skin.",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": { "$ref": "#/$defs/hex" },
          "properties": {
            "bar": {
              "$ref": "#/$defs/hex",
              "default": "1F2535",
              "description": "Bar background."
            },
            "edge": {
              "$ref": "#/$defs/hex",
              "default": "394258",
              "description": "Borders and cell dividers."
            },
            "panel": {
              "$ref": "#/$defs/hex",
              "default": "1B2130",
              "description": "Window body."
            },
            "title": {
              "$ref": "#/$defs/hex",
              "default": "333B50",
              "description": "Window title bar."
            },
            "accent": {
              "$ref": "#/$defs/hex",
              "default": "4B546D",
              "description": "Focused title, hover row, toggle on."
            },
            "well": {
              "$ref": "#/$defs/hex",
              "default": "141926",
              "description": "Lists and fields."
            },
            "button": {
              "$ref": "#/$defs/hex",
              "default": "2A3142",
              "description": "Buttons."
            },
            "text": {
              "$ref": "#/$defs/hex",
              "default": "CDD3E0",
              "description": "Body text."
            },
            "dim": {
              "$ref": "#/$defs/hex",
              "default": "8891A6",
              "description": "Captions and keys."
            },
            "on": {
              "$ref": "#/$defs/hex",
              "default": "9DB0DA",
              "description": "Current-value mark, toggle underline, focused field."
            },
            "value": {
              "$ref": "#/$defs/hex",
              "default": "FFFFFF",
              "description": "Values and titles."
            },
            "strip": {
              "$ref": "#/$defs/hex",
              "default": "23262E",
              "description": "The TFC strip."
            },
            "bevel_light": {
              "$ref": "#/$defs/hex",
              "default": "394258",
              "description": "Raised bevel top-left (sunken bottom-right)."
            },
            "bevel_dark": {
              "$ref": "#/$defs/hex",
              "default": "141926",
              "description": "Raised bevel bottom-right."
            },
            "selection": {
              "$ref": "#/$defs/hex",
              "default": "4B546D",
              "description": "Selection bar and field selection."
            },
            "selection_text": {
              "$ref": "#/$defs/hex",
              "default": "FFFFFF",
              "description": "Text on the selection bar."
            },
            "field": {
              "$ref": "#/$defs/hex",
              "default": "141926",
              "description": "Edit fields."
            },
            "field_text": {
              "$ref": "#/$defs/hex",
              "default": "FFFFFF",
              "description": "Text in edit fields."
            },
            "inactive": {
              "$ref": "#/$defs/hex",
              "default": "333B50",
              "description": "An unfocused window's top strip."
            },
            "ok": {
              "$ref": "#/$defs/hex",
              "default": "9FE0B8",
              "description": "Good state text."
            },
            "warn": {
              "$ref": "#/$defs/hex",
              "default": "F2C14E",
              "description": "Caution state text."
            },
            "alert": {
              "$ref": "#/$defs/hex",
              "default": "FF7A7A",
              "description": "Alert state text."
            },
            "clock": {
              "$ref": "#/$defs/hex",
              "default": "FFFFFF",
              "description": "The clock."
            },
            "hover_text": {
              "$ref": "#/$defs/hex",
              "default": "FFFFFF",
              "description": "Hovered text."
            },
            "strip_text": {
              "$ref": "#/$defs/hex",
              "default": "CDD3E0",
              "description": "Flight strip text."
            },
            "scope": {
              "$ref": "#/$defs/hex",
              "default": "0E131C",
              "description": "The radar scope behind frameless text."
            },
            "radio_rx": {
              "$ref": "#/$defs/hex",
              "default": "2E4A3A",
              "description": "The RX (and SENT) radio pill."
            },
            "radio_rx_text": {
              "$ref": "#/$defs/hex",
              "default": "9FE0B8",
              "description": "The RX (and SENT) radio pill's text."
            },
            "radio_tx": {
              "$ref": "#/$defs/hex",
              "default": "5A2E2E",
              "description": "The TX radio pill."
            },
            "radio_tx_text": {
              "$ref": "#/$defs/hex",
              "default": "FFB3B3",
              "description": "The TX radio pill's text."
            },
            "radio_blocked": {
              "$ref": "#/$defs/hex",
              "default": "5A4A1E",
              "description": "The BLOCKED radio pill."
            },
            "radio_blocked_text": {
              "$ref": "#/$defs/hex",
              "default": "F2C14E",
              "description": "The BLOCKED radio pill's text."
            },
            "radio_parsing": {
              "$ref": "#/$defs/hex",
              "default": "2F3A5A",
              "description": "The PARSING radio pill."
            },
            "radio_parsing_text": {
              "$ref": "#/$defs/hex",
              "default": "B9C8F0",
              "description": "The PARSING radio pill's text."
            }
          }
        },
        "fonts": {
          "type": "object",
          "description": "Font roles, each naming a bundled font.",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": { "$ref": "#/$defs/font_id" },
          "properties": {
            "text": {
              "$ref": "#/$defs/font_id",
              "default": "noto_sans",
              "description": "Chrome text."
            },
            "data": {
              "$ref": "#/$defs/font_id",
              "default": "courier_prime",
              "description": "Data: idents and numbers."
            }
          }
        },
        "type": {
          "type": "object",
          "description": "Type sizes in px at 1080p.",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": { "$ref": "#/$defs/size" },
          "properties": {
            "title": {
              "$ref": "#/$defs/size",
              "default": 13,
              "description": "Window titles."
            },
            "list": {
              "$ref": "#/$defs/size",
              "default": 14,
              "description": "List rows."
            },
            "field": {
              "$ref": "#/$defs/size",
              "default": 14,
              "description": "Edit fields."
            },
            "button": {
              "$ref": "#/$defs/size",
              "default": 13,
              "description": "Buttons."
            },
            "small": {
              "$ref": "#/$defs/size",
              "default": 11,
              "description": "Small buttons."
            },
            "caption": {
              "$ref": "#/$defs/size",
              "default": 11,
              "description": "Captions."
            },
            "tick": {
              "$ref": "#/$defs/size",
              "default": 13,
              "description": "Tick rows."
            },
            "close": {
              "$ref": "#/$defs/size",
              "default": 16,
              "description": "The close glyph."
            },
            "bar_key": {
              "$ref": "#/$defs/size",
              "default": 12,
              "description": "Bar cell keys."
            },
            "bar_value": {
              "$ref": "#/$defs/size",
              "default": 15,
              "description": "Bar cell values."
            },
            "bar_label": {
              "$ref": "#/$defs/size",
              "default": 13,
              "description": "Bar toggle words."
            },
            "dcb": {
              "$ref": "#/$defs/size",
              "default": 13,
              "description": "DCB button labels."
            },
            "status": {
              "$ref": "#/$defs/size",
              "default": 15,
              "description": "Status line text."
            }
          }
        },
        "case": {
          "type": "string",
          "enum": ["as_written", "upper"],
          "default": "as_written",
          "description": "Chrome and list text as written or in capitals."
        },
        "bevel": {
          "type": "object",
          "additionalProperties": false,
          "description": "The bevel every `bevel` box uses unless it sets its own border.",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8,
              "default": 0,
              "x-px": true,
              "description": "Raised and sunken edge width in px."
            }
          }
        }
      }
    },
    "font_id": {
      "type": "string",
      "enum": ["noto_sans", "courier_prime", "barlow_semi_condensed"],
      "description": "A bundled font: Noto Sans (variable weight), Courier Prime Bold, Barlow Semi Condensed (600 and 700)."
    },
    "size": {
      "type": "integer",
      "minimum": 6,
      "maximum": 48,
      "x-px": true,
      "description": "Whole design pixels at interface size 1.0."
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "description": "How a control's background is drawn.",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["flat", "bevel", "none"],
          "default": "flat",
          "description": "flat fill with an optional border, a raised or sunken bevel, or nothing."
        },
        "fill": {
          "$ref": "#/$defs/color_role",
          "description": "Fill colour; none when left out."
        },
        "blend": {
          "$ref": "#/$defs/color_role",
          "description": "A colour mixed into the fill."
        },
        "blend_amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5,
          "description": "How much of `blend` is mixed in."
        },
        "lighten": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0,
          "description": "Lightens the fill by this much (SACTA's close cell)."
        },
        "border": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8,
          "x-px": true,
          "description": "Border or bevel edge width in px; a bevel box without it uses tokens.bevel.width."
        },
        "border_color": {
          "$ref": "#/$defs/color_role",
          "description": "Flat border colour."
        },
        "raised": {
          "type": "boolean",
          "default": true,
          "description": "Bevel: light edge top-left (raised) or bottom-right (sunken)."
        },
        "light": {
          "$ref": "#/$defs/color_role",
          "description": "Bevel light edge."
        },
        "dark": {
          "$ref": "#/$defs/color_role",
          "description": "Bevel dark edge."
        },
        "edge_lighten": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Bevel: the light edge is the fill lightened by this much instead of `light`."
        },
        "edge_darken": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Bevel: the dark edge is the fill darkened by this much instead of `dark`."
        },
        "pad": {
          "$ref": "#/$defs/pad",
          "description": "Content padding (left, top, right, bottom) inside the border, the bevel and `inset`; a flat box without it pads by its border."
        },
        "tight": {
          "type": "boolean",
          "default": false,
          "description": "Bevel: the content margins are `pad` alone, so a small glyph fits a thin strip (SACTA's close cell)."
        },
        "inset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16,
          "default": 0,
          "x-px": true,
          "description": "Gap between the box and its content edge."
        },
        "underline": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8,
          "default": 0,
          "x-px": true,
          "description": "Underline height in px."
        },
        "underline_color": { "$ref": "#/$defs/color_role" },
        "left_bar": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8,
          "default": 0,
          "x-px": true,
          "description": "Bar on the left edge in px."
        },
        "left_bar_color": { "$ref": "#/$defs/color_role" }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "description": "A control's look in one state. Every state starts from `normal` and changes only what it names.",
      "properties": {
        "box": { "$ref": "#/$defs/box" },
        "text": { "$ref": "#/$defs/color_role", "description": "Text colour." },
        "font": { "$ref": "#/$defs/font_role" },
        "weight": {
          "type": "integer",
          "enum": [400, 600, 700],
          "default": 400,
          "description": "Font weight."
        },
        "type": {
          "$ref": "#/$defs/type_role",
          "description": "Text size role."
        },
        "spacing": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5,
          "default": 0,
          "description": "Letter spacing in em."
        },
        "selection": {
          "$ref": "#/$defs/color_role",
          "description": "Fields: selected text background."
        },
        "placeholder": {
          "$ref": "#/$defs/color_role",
          "description": "Fields: placeholder text."
        }
      }
    },
    "states": {
      "type": "object",
      "additionalProperties": false,
      "description": "Looks per state; `normal` is the base of the others.",
      "properties": {
        "normal": { "$ref": "#/$defs/state" },
        "hover": { "$ref": "#/$defs/state" },
        "pressed": { "$ref": "#/$defs/state" },
        "on": { "$ref": "#/$defs/state" },
        "disabled": { "$ref": "#/$defs/state" },
        "focused": { "$ref": "#/$defs/state" },
        "current": { "$ref": "#/$defs/state" }
      }
    },
    "primitives": {
      "type": "object",
      "additionalProperties": false,
      "description": "The controls every component is built from.",
      "properties": {
        "window": {
          "type": "object",
          "additionalProperties": false,
          "description": "A session window. States style its title bar; `focused` is the window with focus.",
          "properties": {
            "top_strip": {
              "type": "string",
              "enum": ["none", "bar"],
              "default": "none",
              "x-capability": "window.top_strip",
              "description": "none, or a thin bar above the title (SACTA) that drags the window and lights when focused."
            },
            "close": {
              "type": "string",
              "enum": ["glyph", "cell", "hidden"],
              "default": "glyph",
              "x-capability": "window.close",
              "description": "A close glyph in the title, a close cell in the top strip, or none (the surface's click-away and Escape close it)."
            },
            "strip": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "height": { "$ref": "#/$defs/px", "default": 10 },
                "fill": {
                  "$ref": "#/$defs/color_role",
                  "default": "accent",
                  "description": "Focused strip."
                },
                "inactive": {
                  "$ref": "#/$defs/color_role",
                  "default": "inactive",
                  "description": "Unfocused strip."
                },
                "box": {
                  "$ref": "#/$defs/box",
                  "description": "How the strip is drawn; its fill is `fill` or `inactive`."
                },
                "cell_glyph": {
                  "type": "string",
                  "maxLength": 4,
                  "default": "▪▫",
                  "description": "The glyph cell beside the close cell, drawn like the close cell."
                },
                "cell_width": { "$ref": "#/$defs/px", "default": 19 }
              }
            },
            "close_button": {
              "type": "object",
              "additionalProperties": false,
              "description": "The close control: the glyph in the title (`close` glyph) or the cell in the top strip (`close` cell).",
              "properties": {
                "glyph": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4,
                  "default": "×"
                },
                "width": { "$ref": "#/$defs/px", "default": 20 },
                "height": { "$ref": "#/$defs/px", "default": 20 },
                "states": { "$ref": "#/$defs/states" }
              }
            },
            "title": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "height": { "$ref": "#/$defs/px", "default": 26 },
                "align": {
                  "type": "string",
                  "enum": ["left", "center"],
                  "default": "left"
                },
                "pad": { "$ref": "#/$defs/pad" },
                "gap": {
                  "$ref": "#/$defs/px",
                  "default": 16,
                  "description": "Between the title and the close glyph."
                }
              }
            },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "pad": { "$ref": "#/$defs/pad" },
                "gap": { "$ref": "#/$defs/px", "default": 8 },
                "box": { "$ref": "#/$defs/box" }
              }
            },
            "states": { "$ref": "#/$defs/states" }
          }
        },
        "list": {
          "type": "object",
          "additionalProperties": false,
          "description": "Value lists (TL, CFL, speed, menu rows).",
          "properties": {
            "row_height": { "$ref": "#/$defs/px", "default": 24 },
            "separation": { "$ref": "#/$defs/px", "default": 8 },
            "panel": { "$ref": "#/$defs/box" },
            "current": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mark": {
                  "type": "string",
                  "maxLength": 8,
                  "default": "",
                  "description": "Text after the current value."
                },
                "left_bar": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 8,
                  "default": 0,
                  "x-px": true
                },
                "left_bar_color": { "$ref": "#/$defs/color_role" }
              }
            },
            "states": { "$ref": "#/$defs/states" }
          }
        },
        "field": {
          "type": "object",
          "additionalProperties": false,
          "description": "Edit fields.",
          "properties": {
            "height": { "$ref": "#/$defs/px", "default": 26 },
            "states": { "$ref": "#/$defs/states" }
          }
        },
        "button": {
          "type": "object",
          "additionalProperties": false,
          "description": "Buttons and small buttons.",
          "properties": {
            "height": { "$ref": "#/$defs/px", "default": 28 },
            "small_height": { "$ref": "#/$defs/px", "default": 20 },
            "pad_x": { "$ref": "#/$defs/px", "default": 12 },
            "small_pad_x": { "$ref": "#/$defs/px", "default": 6 },
            "states": { "$ref": "#/$defs/states" }
          }
        },
        "tick": {
          "type": "object",
          "additionalProperties": false,
          "description": "Tick rows (MAPS, AIRSPACES).",
          "properties": {
            "size": { "$ref": "#/$defs/px", "default": 12 },
            "separation": { "$ref": "#/$defs/px", "default": 8 },
            "row_height": { "$ref": "#/$defs/px", "default": 24 },
            "on_mark": { "$ref": "#/$defs/box" },
            "off_mark": { "$ref": "#/$defs/box" },
            "states": { "$ref": "#/$defs/states" }
          }
        },
        "caption": {
          "type": "object",
          "additionalProperties": false,
          "description": "Small headings.",
          "properties": {
            "states": { "$ref": "#/$defs/states" }
          }
        },
        "bar": {
          "type": "object",
          "additionalProperties": false,
          "description": "The top and bottom bars.",
          "properties": {
            "height": { "$ref": "#/$defs/px", "default": 40 },
            "states": { "$ref": "#/$defs/states" }
          }
        },
        "bar_cell": {
          "type": "object",
          "additionalProperties": false,
          "description": "A bar cell: a key over a value, or a toggle word.",
          "properties": {
            "key": { "$ref": "#/$defs/state" },
            "value": { "$ref": "#/$defs/state" },
            "divider": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8,
              "default": 1,
              "x-px": true
            },
            "divider_color": { "$ref": "#/$defs/color_role" },
            "side_pad": {
              "$ref": "#/$defs/px",
              "default": 14,
              "description": "Left and right space around a cell's text."
            },
            "compact_pad": {
              "$ref": "#/$defs/px",
              "default": 10,
              "description": "side_pad when the bar is compact (window under 1600 design px)."
            },
            "key_gap": {
              "$ref": "#/$defs/px",
              "default": 8,
              "description": "Between a key and its value."
            },
            "group_gap": {
              "$ref": "#/$defs/px",
              "default": 10,
              "description": "Between key-value groups in one row."
            },
            "value_tint": {
              "type": "boolean",
              "default": false,
              "description": "Values that carry a status colour (QNH in ok, the clock in clock) read in it instead of value.text."
            },
            "button_pad": {
              "$ref": "#/$defs/pad",
              "description": "Bottom-bar buttons' text padding (Generic keeps the toggle's underline free at the bottom)."
            },
            "step": {
              "$ref": "#/$defs/state",
              "description": "A stepper's - and + buttons."
            },
            "step_width": { "$ref": "#/$defs/px", "default": 22 },
            "step_height": { "$ref": "#/$defs/px", "default": 20 },
            "step_gap": {
              "$ref": "#/$defs/px",
              "default": 6,
              "description": "Between a step button and the value."
            },
            "states": { "$ref": "#/$defs/states" }
          }
        },
        "dcb_button": {
          "type": "object",
          "additionalProperties": false,
          "description": "A DCB square button.",
          "properties": {
            "unit": { "$ref": "#/$defs/px", "default": 72 },
            "line_height": { "$ref": "#/$defs/px", "default": 15 },
            "pad": { "$ref": "#/$defs/px", "default": 4 },
            "states": { "$ref": "#/$defs/states" }
          }
        },
        "status_line": {
          "type": "object",
          "additionalProperties": false,
          "description": "Frameless status text on the scope.",
          "properties": {
            "line_height": { "$ref": "#/$defs/px", "default": 18 },
            "inset": { "$ref": "#/$defs/px", "default": 10 },
            "gap": {
              "$ref": "#/$defs/px",
              "default": 9,
              "description": "Between the items of one line."
            },
            "states": { "$ref": "#/$defs/states" }
          }
        }
      }
    },
    "slot_entry": {
      "type": ["string", "object", "array"],
      "description": "A feature id, a group {ids, width} (dcb_grid columns: halves stacked in one column), or a line of ids (dcb_grid status: one status line, left to right).",
      "additionalProperties": false,
      "items": { "type": "string" },
      "minItems": 1,
      "maxItems": 8,
      "properties": {
        "ids": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "maxItems": 4
        },
        "width": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 4,
          "default": 1
        }
      }
    },
    "slots": {
      "type": "object",
      "description": "Where the component's features sit: slot name -> entries. The slot names belong to the mode. Every feature of the component appears exactly once.",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/$defs/slot_entry" }
      }
    },
    "templates": {
      "type": "object",
      "description": "Label templates per feature id; {value} is the feature's live value and \\n a line break.",
      "additionalProperties": { "type": "string", "maxLength": 40 }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "description": "Each part of the screen: its layout mode (code behaviour) and, where the mode has slots, where each feature sits. Changing a component's mode starts that component fresh instead of merging the base's slots.",
      "properties": {
        "top": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["cell_row", "dcb_grid"],
              "default": "cell_row",
              "x-capability": "top",
              "description": "cell_row: one row of cells (slots left, right). dcb_grid: STARS square buttons (slots columns, status) that the bottom bar can merge into and menus can dock under."
            },
            "slots": { "$ref": "#/$defs/slots" },
            "templates": { "$ref": "#/$defs/templates" }
          }
        },
        "bottom": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["cell_row", "merged_into_top"],
              "default": "cell_row",
              "x-capability": "bottom",
              "description": "Its own bar, or merged into a top dcb_grid (its features then sit in the top's slots)."
            },
            "slots": { "$ref": "#/$defs/slots" },
            "templates": { "$ref": "#/$defs/templates" }
          }
        },
        "radio": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["pills", "wells", "status_line"],
              "default": "pills",
              "x-capability": "radio"
            }
          }
        },
        "value_popup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["list_window", "split_windows", "dock_strip"],
              "default": "list_window",
              "x-capability": "value_popup",
              "description": "CFL and speed: a window with its list, split windows, or a strip docked under a top dcb_grid."
            },
            "templates": {
              "$ref": "#/$defs/templates",
              "description": "Button words ({value} the live value, \\n a line break): unrestricted, via ({value} the SID), resume (managed speed), send_typed (ACCEPT in split_windows, ENTER in dock_strip). A mode without one uses its own words."
            }
          }
        },
        "wpt": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["window", "split_windows", "dock_strip"],
              "default": "window",
              "x-capability": "wpt"
            }
          }
        },
        "menus": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["kit_window", "numbered_list", "dock_strip"],
              "default": "kit_window",
              "x-capability": "menus",
              "description": "MAPS, PROCS, AIRSPACES."
            }
          }
        },
        "tfc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["dark", "paper_es", "paper_us"],
              "default": "dark",
              "x-capability": "tfc",
              "description": "The selected flight's strip: dark (Generic columns), paper_es (Spanish paper strip; the window is titled with the callsign) or paper_us (US paper strip, three rows)."
            }
          }
        },
        "com": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["table", "well", "scope_lines"],
              "default": "table",
              "x-capability": "com",
              "description": "table: row colours, sizes and the HEARD italic from the session profile, the command behind an accent rule. well and scope_lines: row colours from the skin's roles (pilot text, YOU value, command on, HEARD dim, SYS and NOT SENT warn)."
            },
            "widths": {
              "type": "object",
              "additionalProperties": false,
              "description": "Column, window and log sizes in px.",
              "properties": {
                "who": {
                  "$ref": "#/$defs/panel_px",
                  "description": "Who column (callsign, YOU, SYS, HEARD)."
                },
                "command": {
                  "$ref": "#/$defs/panel_px",
                  "description": "Command column."
                },
                "window": {
                  "$ref": "#/$defs/panel_px",
                  "description": "Window width."
                },
                "log": {
                  "$ref": "#/$defs/panel_px",
                  "description": "Log width."
                },
                "log_height": {
                  "$ref": "#/$defs/panel_px",
                  "description": "Log height."
                }
              }
            },
            "log": {
              "$ref": "#/$defs/box",
              "description": "The log's background: kind none, or a flat or bevel well (fill, raised, pad left and top)."
            },
            "type": {
              "$ref": "#/$defs/type_role",
              "description": "Row text size outside table mode."
            },
            "weight": {
              "type": "integer",
              "enum": [400, 600, 700],
              "default": 400,
              "description": "Said-text weight outside table mode."
            },
            "case": {
              "type": "string",
              "enum": ["as_written", "upper"],
              "default": "as_written",
              "description": "Row text case."
            }
          }
        },
        "vprof": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["well", "scope"],
              "default": "well",
              "x-capability": "vprof",
              "description": "well: the plot under kit buttons. scope: the plot with plain text controls on the scope."
            },
            "well": {
              "$ref": "#/$defs/box",
              "description": "The plot's background: kind none, or a flat or bevel well (fill, raised, pad left and top)."
            },
            "plot_colors": {
              "type": "string",
              "enum": ["own", "skin"],
              "default": "own",
              "description": "own: grey axes, a white position line and the selected-aircraft profile in Noto Sans. skin: axes in text, position in value, profile in on, labels in the data font."
            }
          }
        },
        "tl": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["list"],
              "default": "list",
              "x-capability": "tl"
            },
            "width": {
              "$ref": "#/$defs/panel_px",
              "description": "Window width."
            },
            "templates": {
              "$ref": "#/$defs/templates",
              "description": "tl_list: a row's label, {value} the level in hundreds of feet (FL{value} reads FL140)."
            }
          }
        }
      }
    }
  }
}
