{
  "$schema": "../../tools/interface_contract/interface.schema.json",
  "name": "Spain (SACTA)",
  "author": "Lainoa Software",
  "description": "Spain's SACTA look over Generic: warm grey bevels, thin window bars, paper strips.",
  "extends": "generic",
  "tokens": {
    "colors": {
      "bar": "877B77",
      "edge": "D5D0CC",
      "panel": "877B77",
      "title": "877B77",
      "accent": "A6228E",
      "well": "877B77",
      "button": "877B77",
      "text": "E5E3DD",
      "dim": "B5ADAD",
      "on": "F9EE2E",
      "value": "E5E3DD",
      "strip": "FBFAF6",
      "bevel_light": "BDB6B4",
      "bevel_dark": "51443F",
      "selection": "D5D0CC",
      "selection_text": "231F20",
      "field": "FFFFFF",
      "field_text": "231F20",
      "inactive": "B5ADAD",
      "ok": "8DC63F",
      "warn": "F9EE2E",
      "alert": "EE3029",
      "clock": "F7941D",
      "hover_text": "FFFFFF",
      "strip_text": "111111",
      "scope": "231F20"
    },
    "fonts": {"text": "barlow_semi_condensed", "data": "courier_prime"},
    "type": {"title": 15, "list": 13, "small": 10, "caption": 13, "close": 6, "bar_key": 13},
    "case": "upper",
    "bevel": {"width": 1}
  },
  "primitives": {
    "window": {
      "top_strip": "bar",
      "close": "cell",
      "title": {"height": 30, "align": "center", "pad": [8, 0, 8, 0]},
      "close_button": {"glyph": "✕", "width": 19, "height": 10, "states": {
        "normal": {"box": {"kind": "bevel", "fill": "panel", "lighten": 0.1, "border": 1, "raised": true,
          "light": "bevel_light", "dark": "bevel_dark", "tight": true}, "text": "value", "weight": 700},
        "hover": {"text": "hover_text"}}},
      "body": {"pad": [6, 4, 6, 6], "gap": 5,
        "box": {"kind": "bevel", "fill": "panel", "border": 1, "raised": true, "light": "edge", "dark": "bevel_dark"}},
      "states": {
        "normal": {"box": {"kind": "bevel", "fill": "panel", "raised": true, "light": "bevel_light", "dark": "bevel_dark", "inset": 2},
          "text": "text", "font": "text", "weight": 700, "spacing": 0},
        "focused": {"box": {"fill": "panel"}}
      }
    },
    "list": {
      "row_height": 17,
      "separation": 5,
      "panel": {"kind": "bevel", "fill": "well", "raised": false, "light": "bevel_light", "dark": "bevel_dark", "pad": [2, 2, 2, 2]},
      "current": {"mark": "◂", "left_bar": 0},
      "states": {
        "normal": {"font": "text", "weight": 700},
        "hover": {"box": {"kind": "flat", "fill": "selection"}, "text": "selection_text"},
        "current": {"text": "on"}
      }
    },
    "field": {
      "height": 22,
      "states": {
        "normal": {"box": {"kind": "bevel", "fill": "field", "raised": false, "light": "bevel_light", "dark": "bevel_dark", "pad": [5, 0, 5, 0]},
          "text": "field_text", "selection": "selection"}
      }
    },
    "button": {
      "height": 24,
      "small_height": 14,
      "pad_x": 10,
      "states": {
        "normal": {"box": {"kind": "bevel", "fill": "button", "raised": true, "light": "bevel_light", "dark": "bevel_dark"}, "weight": 700},
        "hover": {"box": {"blend_amount": 0}, "text": "hover_text"},
        "on": {"box": {"fill": "text", "raised": false}, "text": "bevel_dark"}
      }
    },
    "tick": {
      "size": 10,
      "separation": 6,
      "row_height": 17,
      "off_mark": {"kind": "none"},
      "states": {"normal": {"weight": 700}, "hover": {"text": "hover_text"}}
    },
    "caption": {"states": {"normal": {"text": "text", "weight": 700, "spacing": 0}}},
    "bar": {
      "states": {"normal": {"box": {"kind": "bevel", "fill": "bar", "border": 1, "raised": true, "light": "edge", "dark": "bevel_dark"}}}
    },
    "bar_cell": {
      "key": {"text": "text", "weight": 700},
      "value": {"text": "text", "font": "text", "weight": 700},
      "divider_color": "bevel_dark",
      "value_tint": true,
      "button_pad": [4, 0, 4, 0],
      "step": {"box": {"kind": "bevel", "fill": "button", "border": 1, "raised": true, "light": "bevel_light", "dark": "bevel_dark"},
        "text": "text", "font": "text", "weight": 700},
      "states": {
        "normal": {"box": {"kind": "bevel", "fill": "button", "border": 1, "raised": true, "light": "bevel_light", "dark": "bevel_dark"}, "weight": 700},
        "hover": {"box": {"kind": "bevel", "fill": "button"}, "text": "hover_text"},
        "on": {"box": {"kind": "bevel", "fill": "text", "raised": false, "underline": 0}, "text": "bevel_dark"}
      }
    }
  },
  "components": {
    "radio": {"mode": "wells"},
    "value_popup": {"mode": "split_windows"},
    "wpt": {"mode": "split_windows"},
    "menus": {"mode": "numbered_list"},
    "tfc": {"mode": "paper_es"},
    "com": {
      "mode": "well",
      "widths": {"who": 58, "command": 168, "window": 640, "log": 626, "log_height": 150},
      "log": {"kind": "bevel", "fill": "well", "raised": false, "pad": [8, 6, 8, 6]},
      "type": "list", "weight": 600, "case": "as_written"
    },
    "vprof": {
      "well": {"kind": "bevel", "fill": "well", "raised": false, "pad": [4, 4, 4, 4]},
      "plot_colors": "skin"
    },
    "tl": {"width": 90, "templates": {"tl_list": "{value}"}}
  }
}
